class_name 开局配置
extends Resource

@export var 玩家阵营: 棋子配置.阵营类型 = 棋子配置.阵营类型.红方
@export var 先手阵营: 棋子配置.阵营类型 = 棋子配置.阵营类型.红方
@export var 棋子列表: Array[棋子配置] = []

func 验证() -> PackedStringArray:
	var 错误列表 := PackedStringArray()
	var 已占坐标 := {}
	var 将帅数量 := [0, 0]
	for 索引 in 棋子列表.size():
		var 棋子 := 棋子列表[索引]
		if 棋子 == null:
			错误列表.append(语言管理.文本("第 %d 个棋子为空") % (索引 + 1))
			continue
		if 棋子.阵营 < 0 or 棋子.阵营 > 1 or 棋子.棋种 < 0 or 棋子.棋种 > 6:
			错误列表.append(语言管理.文本("第 %d 个棋子的阵营或种类无效") % (索引 + 1))
			continue
		if not 象棋规则.位于棋盘(棋子.棋盘位置):
			错误列表.append(语言管理.文本("第 %d 个棋子坐标越界：%s") % [索引 + 1, 棋子.棋盘位置])
		if 已占坐标.has(棋子.棋盘位置):
			错误列表.append(语言管理.文本("坐标 %s 存在重叠棋子") % 棋子.棋盘位置)
		已占坐标[棋子.棋盘位置] = true
		if 棋子.血量 < 1:
			错误列表.append(语言管理.文本("第 %d 个棋子的血量必须大于零") % (索引 + 1))
		if 棋子.棋种 == 棋子配置.棋种类型.将帅:
			将帅数量[棋子.阵营] += 1
			if not 象棋规则.位于九宫(棋子.棋盘位置, 棋子.阵营):
				错误列表.append(语言管理.文本("将帅必须位于己方九宫"))
	for 阵营 in 2:
		if 将帅数量[阵营] != 1:
			错误列表.append(语言管理.文本("%s必须恰好有一个将帅") % 语言管理.文本("红方" if 阵营 == 棋子配置.阵营类型.红方 else "黑方"))
	if 玩家阵营 < 0 or 玩家阵营 > 1 or 先手阵营 < 0 or 先手阵营 > 1:
		错误列表.append(语言管理.文本("玩家阵营或先手方无效"))
	if 错误列表.is_empty() and 象棋规则.将帅照面(象棋规则.从配置生成(self)):
		错误列表.append(语言管理.文本("开局不得将帅照面"))
	return 错误列表
